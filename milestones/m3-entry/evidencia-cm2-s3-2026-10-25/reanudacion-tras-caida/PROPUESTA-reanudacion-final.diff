+        assert int(suyo) >= int(nuestro) and suyo == crudo[crudo.rindex(")") + 2:].split()[19]
+        assert int(suyo) > 100, "un starttime en ticks desde el arranque no es un contador pequeno"
+    finally:
+        hijo.kill()
