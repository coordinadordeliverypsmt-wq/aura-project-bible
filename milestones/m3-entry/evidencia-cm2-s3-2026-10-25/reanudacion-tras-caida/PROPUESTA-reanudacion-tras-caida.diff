+    def lector(self, *a, **k):
+        if str(self).startswith("/proc/") and str(self).endswith("/stat") and str(self) != "/proc/self/stat":
+            if isinstance(falla_con, str):
+                return falla_con
+            raise falla_con
+        return real(self, *a, **k)
+
+    monkeypatch.setattr(pathlib.Path, "read_text", lector)
+
