     def _coseno(a: list[float], b: list[float]) -> float:
         return sum(x * y for x, y in zip(a, b, strict=True))
 
+    # --- acceso de solo lectura al corpus (D-N2-2) y alineamiento de vectores (D-N2-5) ---
+    @property
+    def _items(self) -> list[dict]:
+        """Las entradas vigentes, las MISMAS que ve N1. `ModeloUsuario` y `EjecutorModeloUsuario` leen
+        `memoria._items`: sin esto, con N2 activa el modelo de usuario ni siquiera podia listarse."""
+        return self._store._items
+
+    def _realinear(self, antes: list[dict]) -> None:
+        """Rehace `_vectores` para que correspondan 1:1 con `self._store._items` tras una mutacion de N1.
+
+        `antes` es la lista de items ANTES de la mutacion, alineada con los vectores que habia. Se reutiliza
+        el vector por IDENTIDAD de item (olvidar/marcar conservan los mismos dicts) y, si no, por CONTENIDO
+        (restore reconstruye los dicts: el embedding depende solo del texto). Solo se re-embebe lo que no
+        tenia vector: coste cero en olvidar/marcar y, en restore, solo los contenidos nuevos para N2
+        (~305 ms por recuerdo medido, D-N2-3).
+        """
+        por_id = {id(it): v for it, v in zip(antes, self._vectores, strict=True)}
+        por_contenido = {it["content"]: v for it, v in zip(antes, self._vectores, strict=True)}
+        nuevos: list[list[float]] = []
+        for it in self._store._items:
+            vec = por_id.get(id(it)) or por_contenido.get(it["content"])
+            nuevos.append(vec if vec is not None else self._embed(it["content"]))
+        self._vectores = nuevos
+
+    def olvidar(self, predicado) -> int:
+        """Soberania del usuario sobre N2: delega en N1 (lapida append-only) y realinea los vectores."""
+        antes = list(self._store._items)
+        n = self._store.olvidar(predicado)
+        self._realinear(antes)
+        return n
+
+    def marcar(self, predicado, campos: dict) -> int:
+        """Delega en N1 (anexa la marca). Los items no cambian de identidad: los vectores siguen vigentes."""
+        antes = list(self._store._items)
+        n = self._store.marcar(predicado, campos)
+        self._realinear(antes)
+        return n
+
+    # --- backup/restore: se delegan en N1 y se realinean (fragilidad latente ante restore) ---
+    def backup(self) -> str:
+        return self._store.backup()
+
+    def verify(self, backup_name: str) -> bool:
+        return self._store.verify(backup_name)
+
+    def restore(self, backup_name: str) -> bool:
+        antes = list(self._store._items)
+        ok = self._store.restore(backup_name)
+        self._realinear(antes)
+        return ok
+
