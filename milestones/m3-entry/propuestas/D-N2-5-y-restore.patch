+    def _lapidas_vigentes(self) -> set[tuple]:
+        """Claves cuya ULTIMA linea del fichero activo es una lapida (lo olvidado y no vuelto a declarar).
+
+        Si el usuario volvio a declarar el contenido despues de olvidarlo, la ultima linea de su clave ya
+        no es lapida y no se reimpone: manda lo ultimo que dijo (misma regla que `_proyectar`).
+        Una linea ilegible se ignora aqui: restaurar es la via de recuperacion ante un fichero danado.
+        """
+        if not os.path.exists(self._path):
+            return set()
+        ultima: dict[tuple, bool] = {}
+        with open(self._path, encoding="utf-8") as f:
+            for linea in f:
+                if not linea.strip():
+                    continue
+                try:
+                    reg = json.loads(linea)
+                except json.JSONDecodeError:
+                    continue
+                if isinstance(reg, dict):
+                    ultima[_clave(reg)] = bool(reg.get(_LAPIDA))
+        return {k for k, es_lapida in ultima.items() if es_lapida}
